generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudentProfile {
  id                  String   @id @default(cuid())
  matric              String   @unique
  firstName           String
  lastName            String
  program             String
  headline            String   @default("Verified builder · Live deployable work")
  email               String   @unique
  avatarInitials      String
  avatarUrl           String?
  passwordHash        String
  accountRole         Role     @default(STUDENT)
  status              AccountStatus @default(pending)
  mustChangePassword  Boolean  @default(true)
  notifyAssignments   Boolean  @default(true)
  notifyGrades        Boolean  @default(true)
  notifyPortfolio     Boolean  @default(true)
  publicProfile       Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastLoginAt         DateTime?

  assignments         ProjectSnapshot[]
  artifacts           PortfolioArtifact[]
  uploads             CloudinaryAsset[]
  deployments         ProjectDeployment[]
  enrollments         Enrollment[]

  @@index([accountRole])
  @@index([status])
  @@index([email])
}

model ProjectSnapshot {
  id             String   @id @default(cuid())
  studentMatric  String
  assignmentId   String
  projectName    String
  files          Json
  savedAt        DateTime @default(now())
  submittedAt    DateTime?
  deployUrl      String?
  score          Int?

  student        StudentProfile @relation(fields: [studentMatric], references: [matric], onDelete: Cascade)

  @@index([studentMatric])
  @@index([assignmentId])
}

model ProjectDeployment {
  id            String   @id @default(cuid())
  studentMatric String
  assignmentId  String
  projectName   String
  files         Json
  deployUrl     String
  deployedAt    DateTime @default(now())
  isLatest      Boolean  @default(true)
  approved      Boolean  @default(false)
  approvedAt    DateTime?
  reviewerId    String?
  reviewerName  String?
  reviewNote    String?
  status        DeploymentStatus @default(DEPLOYED)

  student       StudentProfile @relation(fields: [studentMatric], references: [matric], onDelete: Cascade)

  @@index([studentMatric])
  @@index([assignmentId])
  @@index([deployUrl])
  @@index([isLatest])
}

enum DeploymentStatus {
  BUILDING
  DEPLOYED
  SUBMITTED
  APPROVED
  REJECTED
}

model PortfolioArtifact {
  id              String   @id @default(cuid())
  studentMatric   String
  studentName     String
  assignmentId    String
  courseId        String
  courseName      String
  title           String
  description     String?
  score           Int?
  maxScore        Int
  deployUrl       String?
  timestamp       DateTime @default(now())
  submittedAt     DateTime @default(now())
  verified        Boolean  @default(false)
  verifiedAt      DateTime?
  lecturerId      String?
  lecturerName    String?
  lecturerNote    String?
  hash            String   @unique
  status          ArtifactStatus @default(PENDING)
  skills          String[]
  thumbnailGradient String?

  student         StudentProfile @relation(fields: [studentMatric], references: [matric], onDelete: Cascade)

  @@index([studentMatric])
  @@index([status])
  @@index([verified])
}

model CloudinaryAsset {
  id            String   @id @default(cuid())
  publicId      String   @unique
  secureUrl     String
  resourceType  String
  format        String
  width         Int?
  height        Int?
  bytes         Int?
  createdAt     DateTime @default(now())
  studentMatric String?

  student       StudentProfile? @relation(fields: [studentMatric], references: [matric], onDelete: SetNull)

  @@index([studentMatric])
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum AccountStatus {
  active
  pending
  suspended
}

enum ArtifactStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum ReviewWorkflowStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
}

model Review {
  id                String               @id @default(cuid())
  studentMatric     String
  assignmentId      String
  projectSnapshotId String?
  title             String
  summary           String?
  priority          String               @default("MEDIUM")
  deadline          DateTime?
  status            ReviewWorkflowStatus @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewStartedAt   DateTime?
  publishedAt       DateTime?
  publishNote       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  reviewerMatric    String?
  reviewerName      String?
  outcomeNote       String?

  comments          ReviewComment[]
  revisions         Revision[]
  checklist         ReviewChecklist[]
  notifications     Notification[]
  rating            ReviewRating?

  @@index([studentMatric])
  @@index([assignmentId])
  @@index([status])
}

model ReviewComment {
  id           String   @id @default(cuid())
  reviewId     String
  authorMatric String
  authorRole   String
  message      String
  createdAt    DateTime @default(now())
  isInternal   Boolean  @default(false)
  feedbackType String   @default("GENERAL")
  filePath     String?
  lineNumber   Int?
  priority     String   @default("MEDIUM")
  status       String   @default("OPEN")
  resolvedAt   DateTime?

  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Revision {
  id               String               @id @default(cuid())
  reviewId         String
  studentMatric    String
  summary          String?
  status           ReviewWorkflowStatus @default(DRAFT)
  submittedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  revisionNumber   Int                  @default(1)
  sourceRevisionId String?
  deploymentUrl    String?
  submitterMatric  String?
  submitterRole    String?

  review           Review               @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  files            RevisionFile[]

  @@index([reviewId])
  @@index([studentMatric])
}

model RevisionFile {
  id         String   @id @default(cuid())
  revisionId String
  fileName   String
  fileUrl    String?
  fileType   String?
  sizeBytes  Int?
  fileHash   String?
  createdAt  DateTime @default(now())

  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId])
}

model ReviewRating {
  id             String  @id @default(cuid())
  review         Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId       String  @unique
  codeQuality    Int?
  uiUx           Int?
  responsiveness Int?
  accessibility  Int?
  performance    Int?
  bestPractices  Int?
  overall        Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id              String   @id @default(cuid())
  recipientMatric String
  reviewId        String?
  message         String
  type            String   @default("review")
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  review          Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([recipientMatric])
  @@index([isRead])
}

model ReviewChecklist {
  id        String   @id @default(cuid())
  reviewId  String
  title     String
  checked   Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Assignment {
  id           String   @id @default(cuid())
  title        String
  description  String?
  instructions String?
  deadline     DateTime?
  status       AssignmentStatus @default(DRAFT)
  maxScore     Int
  difficulty   String
  engagement   String?
  enrolled     Int     @default(0)
  submitted    Int     @default(0)
  starterFiles Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments  Enrollment[]

  @@index([status])
}

model Enrollment {
  id            String   @id @default(cuid())
  assignmentId  String
  studentMatric String
  status        EnrollmentStatus @default(NOT_STARTED)
  startedAt     DateTime?
  submittedAt   DateTime?
  score         Int?
  deployUrl     String?

  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentMatric], references: [matric], onDelete: Cascade)

  @@index([assignmentId])
  @@index([studentMatric])
}
