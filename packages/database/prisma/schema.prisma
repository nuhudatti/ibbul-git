// Project ULA – Unified Learning Architecture
// Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  LECTURER
  ADMIN
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum DeploymentStatus {
  PENDING
  BUILDING
  SUCCESS
  FAILED
}

enum SubmissionStatus {
  PENDING
  GRADING
  GRADED
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  assignments Assignment[]
}

model User {
  id            String   @id @default(cuid())
  matricNumber  String
  email         String?
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole @default(STUDENT)
  institutionId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution   Institution            @relation(fields: [institutionId], references: [id])
  projects      Project[]
  enrollments   AssignmentEnrollment[]
  assignments   Assignment[]           @relation("AssignmentCreator")
  aiConversations AiConversation[]
  gradesGiven   Grade[]                @relation("GradeReviewer")

  @@unique([matricNumber, institutionId])
  @@index([institutionId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  isTemplate  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id])
  files       ProjectFile[]
  snapshots   ProjectSnapshot[]
  deployments Deployment[]
  submissions Submission[]
  aiConversations AiConversation[]

  @@index([ownerId])
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String   @db.Text
  language  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

model ProjectSnapshot {
  id        String   @id @default(cuid())
  projectId String
  label     String?
  files     Json
  hash      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Assignment {
  id            String           @id @default(cuid())
  title         String
  description   String           @db.Text
  instructions  String           @db.Text
  deadline      DateTime?
  status        AssignmentStatus @default(DRAFT)
  rubric        Json?
  starterTemplate Json?
  maxScore      Int              @default(100)
  institutionId String
  creatorId     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institution Institution            @relation(fields: [institutionId], references: [id])
  creator     User                   @relation("AssignmentCreator", fields: [creatorId], references: [id])
  enrollments AssignmentEnrollment[]

  @@index([institutionId])
  @@index([creatorId])
}

model AssignmentEnrollment {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       EnrollmentStatus @default(NOT_STARTED)
  projectId    String?
  enrolledAt   DateTime         @default(now())
  submittedAt  DateTime?
  updatedAt    DateTime         @updatedAt

  assignment Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User        @relation(fields: [studentId], references: [id])
  submission Submission?

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Submission {
  id           String           @id @default(cuid())
  enrollmentId String           @unique
  projectId    String
  status       SubmissionStatus @default(PENDING)
  snapshotId   String?
  submittedAt  DateTime         @default(now())

  enrollment AssignmentEnrollment @relation(fields: [enrollmentId], references: [id])
  project    Project              @relation(fields: [projectId], references: [id])
  grade      Grade?

  @@index([projectId])
}

model Grade {
  id              String   @id @default(cuid())
  submissionId    String   @unique
  score           Float
  maxScore        Float    @default(100)
  breakdown       Json
  feedback        String   @db.Text
  aiGenerated     Boolean  @default(true)
  reviewerId      String?
  reviewedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User?      @relation("GradeReviewer", fields: [reviewerId], references: [id])
}

model Deployment {
  id          String           @id @default(cuid())
  projectId   String
  status      DeploymentStatus @default(PENDING)
  url         String?
  buildLogs   String?          @db.Text
  error       String?
  deployedAt  DateTime?
  createdAt   DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
}
